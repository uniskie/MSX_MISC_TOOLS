@ECHO OFF

SET ORG_NAME=%~dpn1
SET ORG_EXT=%~x1
SET OUTPUT=%ORG_NAME%_COMB%ORG_EXT%

IF "%~2"=="" (
 ECHO NO COMBINE FILES.
 GOTO ERROREND
)

SETLOCAL ENABLEDELAYEDEXPANSION
SET OPT=

:CLOOP
REM ECHO "%~1"
SET OPT=!OPT!"%~1" /B+
SHIFT
IF NOT "%~1"=="" GOTO CLOOP

REM ECHO WILL YOU COMBINE THESE FILES
REM ECHO to "%OUTPUT%" ?
REM PAUSE

:DOCOPY
SET OPT=%OPT:~0,-1%
ECHO COPY %OPT% %OUTPUT%
COPY %OPT% "%OUTPUT%"

ECHO Created. "%OUTPUT%"

ENDLOCAL

:END
PAUSE
EXIT /B 0

:ERROREND
PAUSE
EXIT /B 1

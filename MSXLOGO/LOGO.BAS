420 Y=Y+DY+DY:GOTO 100
500 '4:COORD L
510 CIRCLE(X+DX,Y+DY),ABS(DY*S)-1,C,P0#,P1#
520 Y=Y+DY+DY:GOTO 100
600 '5:PAINT
610 PAINT(X+DX,Y+DY),PC,C
620 PSET(X+DX,Y+DY),C 'DEBUG
640 X=X+DX:Y=Y+DY:GOTO 100
900 'END
910 END

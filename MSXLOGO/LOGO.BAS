10 DEFINT I,M,S,C:SC=7:COLOR15,4,7
20 SCREEN SC:S=1-(SC=6)-(SC=7)
30 W=3*S:H=3:C=7:PC=15:M=0:DX=0:DY=0
40 X=(256*S-64*W)\2:Y=(192-22*H)\2
50 PI#=3.1415926535#:P0#=PI#/2:P1#=P0#+PI#:P2=P1#+PI#
60 LINE(X-W*5,Y-H*3)-STEP(74*W,28*H),1,BF
70 FOR I=X-W*5 TO X+74*W STEP W:LINE(I,Y-H*3)-STEP(0,28*H),4:NEXT
80 FOR I=Y-H*3 TO Y+27*H STEP H:LINE(X-W*5,I)-STEP(74*W,0),4:NEXT
90 '
100 READ M,DX,DY
110 DX=DX*W:DY=DY*H
120 ON M GOTO 200,300,400,500,600
130 '
140 IF INKEY$<>""THEN 140

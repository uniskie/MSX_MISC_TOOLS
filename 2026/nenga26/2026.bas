10 CLEAR 200,&HB000:DEFINT A-Z
15 DIM X(3),Y(3),P(3),V(3),C(3),CL(3),CF(7),TC(5)
20 COLOR 15,0,0:SCREEN 2,2
30 'DEFUSR=&H7E:A=USR(0)'SET VDP TO GRP2-> CAN'T USE CHR255
40 FOR I=0 TO &H2FF:VPOKE I+&H1800,32:NEXT'CLS
50 VDP(4)=0:VDP(3)=&H9F'PAT/COL USES SAME AREA
60 ON ERROR GOTO 100
70 A$="212000353464327437532356632643563664241535555777"'MSX1PAL
80 FOR I=0 TO 15:COLOR=(I,VAL(MID$(A$,I*3+1,1)),VAL(MID$(A$,I*3+2,1)),VAL(MID$(A$,I*3+3,1))):NEXT
90 ON ERROR GOTO 0:GOTO 110
100 RESUME 90
110 ' LOAD GRAPHIC
120 BLOAD"2026.PAT",S
130 BLOAD"2026.COL",S
140 BLOAD"2026.SPR",S
150 ' LOAD BGM
160 AD=&HB000
170 BLOAD"NDP.BIN",R:ON STOP GOSUB 2040:ON ERROR GOTO 2020
180 DEFUSR=&HC003'PL
190 DEFUSR1=&HC006'ST
200 DEFUSR2=&HC00C'AD
210 DEFUSR9=&HC04B'ED
220 BLOAD"HALNOUMI.NDP",AD
230 STOP ON:A=USR2(AD):A=USR(0)
240 ' SETUP PARAMETERS
250 FOR I=0 TO 3:X(I)=RND(1)*255:Y(I)=14+I*2:P(I)=I:NEXT
260 C(0)=16:C(1)=12:C(2)=8:C(3)=8
270 V(0)=2:V(1)=4:V(2)=6:V(3)=10
280 CL(0)=9:CL(1)=13:CL(2)=6:CL(3)=14
285 FOR I=0 TO 7:CF(I)=VAL("&H"+MID$("145E7ABF",I+1,1)):NEXT
290 ' DRAW BASE PARTS
300 GOSUB 580:GOSUB 1000:GOSUB 810
310 X=3:Y=9:UP=14:GOSUB 1340
320 X=27:Y=9:UP=15:GOSUB 1340
330 ' DRAW FUJIYAMA
340 GOSUB 1180
350 X=8 :Y=5:UP=4+((P+0)AND 3):GOSUB 1340
360 X=11:Y=5:UP=4+((P+1)AND 3):GOSUB 1340
370 X=19:Y=5:UP=4+((P+2)AND 3):GOSUB 1340
380 X=22:Y=5:UP=4+((P+3)AND 3):GOSUB 1340
390 ' DRAW MMOVING OBJECTS
400 TX=36+RND(2)*44:TY=60+RND(3)*10:TC=VAL("&H"+MID$("D496",P+1,1))
410 FOR XI=0 TO 63
420  TIME=0:I4=XI AND 3:I1=XI AND 1:I6=XI\16
430  FOR J=0 TO 3:PI=3-J
440   'X=X(J)/8:Y=Y(J):UP=4+P(J)/8:GOSUB 1410
450   X(J)=(X(J)+V(J))AND 255:P(J)=(P(J)+1)AND 3
460   'X=X(J)/8:UP=4+P(J)/8:GOSUB 1340
470   X=X(J):Y=Y(J)*8:UP=C(J)+P(J):CL=CL(J):GOSUB 1480
480  NEXT
490  PUTSPRITE 4,(24,88),4+P,I4
500  PUTSPRITE 5,(216,88),4+P,I4+4
510  PUTSPRITE 6,(TX+XI+32,TY+I6),TC,40+I1+I6*2
520  IF TIME<9 THEN 520
530 NEXT
540 '
550 P=(P+1)AND 3
560 GOTO 340
570 '
580 '= FADE IN 2026 & KIN-GA-SIN-NEN
590 TY=2*8+64
600 FOR I=0 TO 7+6
610  TIME=0
620  FOR J=0 TO 5
630   K=I-J
640   IF K<8 THEN TC(J)=CF(-K*(K>=0))
650  NEXT
660  GOSUB 910 ' PUT SPR KINGA
670  IF TIME<8 THEN 670
680 NEXT
690 '
700 FOR I=0 TO 32
710  TIME=0
720  FOR J=0 TO 5
730   TC(J)=CF(7-(I\8))
740  NEXT
750  TY=80-I*2
760  GOSUB 910 ' PUT SPR KINGA
770  IF TIME<4 THEN 770
780 NEXT
790 RETURN
800 '
810 '= DELSPRITE KIN-GA-SIN-NEN 2026
820 FOR I=0 TO 5
830  PUTSPRITE I,(0,217),0,36
840 NEXT
850 RETURN
900 '
910 '= PUTSPRITE KIN-GA-SIN-NEN 2026
920 PUTSPRITE 0,( 96,TY),TC(0),56
930 PUTSPRITE 1,(112,TY),TC(1),57
940 PUTSPRITE 2,(128,TY),TC(2),58
950 PUTSPRITE 3,(144,TY),TC(3),59
960 PUTSPRITE 4,(112,TY+24),TC(4),60
970 PUTSPRITE 5,(128,TY+24),TC(5),61
980 RETURN
990 '
1000 '= DRAW 2026
1010 C=24
1020 A=14+5*32+&H1800
1030 FOR I=0 TO 3
1040  VPOKE A+I,C+I
1050  VPOKE A+I+32,C+I+32
1060 NEXT
1070 '
1080 '= DRAW KIN-GA-SIN-NEN
1090 C=16
1100 A=12+2*32+&H1800
1110 FOR I=0 TO 7
1120  VPOKE A+I,C+I
1130  VPOKE A+I+32,C+I+32
1140 NEXT
1150 '
1160 RETURN
1170 '
1180 '= DRAW FUJIYAMA (P:0-3)
1190 C=64+(P AND 1)*16+(P\2)*32*3
1200 B=2+(P AND 1)*3+(P\2)*32
1210 A=8+8*32+&H1800
1220 FOR I=0 TO 15
1230  VPOKE A+I,C+I
1240  VPOKE A+I+32,C+I+32
1250  VPOKE A+I+64,C+I+64
1260  VPOKE A+I+96,B
1270  VPOKE A+I+128,B+1
1280  VPOKE A+I+160,B+2
1290 NEXT
1300 '
1310 RETURN
1320 '
1330 '= DRAW 16*16 PCG
1340 X=X AND 31:C=UP*2:A=X+Y*32+&H1800
1350 VPOKE A,C:VPOKE A+32,C+32
1360 IF X>30 THEN RETURN
1370 VPOKE A+1,C+1:VPOKE A+33,C+33
1380 RETURN
1390 '
1400 '= ERASE 16*16 PCG
1410 X=(X AND 31):A=X+Y*32+&H1800
1420 VPOKE A,32:VPOKE A+32,32
1430 IF X>30 THEN RETURN
1440 VPOKE A+1,32:VPOKE A+33,32
1450 RETURN
1460 '
1470 '= PUT SPRITE
1480 X=X:C=UP
1490 PUTSPRITE PI,(X,Y),CL,C
1500 RETURN
2000 '
2010 '= ERROR on BGM
2020 A=USR1(0):A=USR9(0):ONERRORGOTO0:RESUME 'ERROR
2030 '= STOP on BGM
2040 A=USR1(0):A=USR9(0):PRINT"HAPPY NEW YEAR.":END

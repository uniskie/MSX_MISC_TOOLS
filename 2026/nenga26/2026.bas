100 CLEAR 200,&HB000:DEFINT A-Z:DIM X(3),Y(3),P(3),V(3),C(3),CL(3)
110 COLOR 15,0,0:SCREEN 2,2
120 'DEFUSR=&H7E:A=USR(0)'SET VDP TO GRP2-> CAN'T USE CHR255
130 FOR I=0 TO &H2FF:VPOKE I+&H1800,32:NEXT'CLS
140 VDP(4)=0:VDP(3)=&H9F'PAT/COL USES SAME AREA
150 ON ERROR GOTO 190
160 A$="212000353464327437532356632643563664241535555777"'MSX1PAL
170 FOR I=0 TO 15:COLOR=(I,VAL(MID$(A$,I*3+1,1)),VAL(MID$(A$,I*3+2,1)),VAL(MID$(A$,I*3+3,1))):NEXT
180 ON ERROR GOTO 0:GOTO 200
190 RESUME 180
200 '
201 AD=&HB000
202 BLOAD"NDP.BIN",R:ON STOP GOSUB 2030:ON ERROR GOTO 2010
203 DEFUSR=&HC003'PL
204 DEFUSR1=&HC006'ST
205 DEFUSR2=&HC00C'AD
206 DEFUSR9=&HC04B'ED
207 BLOAD"HALNOUMI.NDP",AD
208 A=USR2(AD):A=USR(0)
209 '
210 BLOAD"2026.PAT",S
220 BLOAD"2026.COL",S
230 BLOAD"2026.SPR",S
240 '
250 FOR I=0 TO 3:X(I)=RND(1)*255:Y(I)=14+I*2:P(I)=I:NEXT
251 C(0)=16:C(1)=12:C(2)=8:C(3)=8
252 V(0)=2:V(1)=4:V(2)=6:V(3)=10
253 CL(0)=9:CL(1)=13:CL(2)=6:CL(3)=14
260 '
270 GOSUB 1010
275 X=3:Y=9:UP=14:GOSUB1340
276 X=27:Y=9:UP=15:GOSUB1340
280 '
290 GOSUB 1190
291 X=8 :Y=5:UP=4+((P+0)AND 3):GOSUB1340
292 X=11:Y=5:UP=4+((P+1)AND 3):GOSUB1340
293 X=19:Y=5:UP=4+((P+2)AND 3):GOSUB1340
294 X=22:Y=5:UP=4+((P+3)AND 3):GOSUB1340
300 '
310 FOR XI=0 TO 79
315  TIME=0
320  FOR PI=0 TO 3
330   'X=X(PI)/8:Y=Y(PI):UP=4+P(PI)/8:GOSUB 1410
340   X(PI)=(X(PI)+V(PI))AND 255:P(PI)=(P(PI)+1)AND 3
350   'X=X(PI)/8:UP=4+P(PI)/8:GOSUB 1340
355   X=X(PI):Y=Y(PI)*8:UP=C(PI)+P(PI):CL=CL(PI):GOSUB 1480
360  NEXT
361  PUTSPRITE 4,(24,88),4+P,(XI AND 3)
362  PUTSPRITE 5,(216,88),4+P,(XI AND 3)+4
365  IF TIME<8 THEN 365
370 NEXT
380 '
390 P=(P+1)AND 3
400 GOTO 290
1000 '
1010 '= DRAW 2026
1020 C=24
1030 A=14+5*32+&H1800
1040 FOR I=0 TO 3
1050  VPOKE A+I,C+I
1060  VPOKE A+I+32,C+I+32
1070 NEXT
1080 '
1090 '= DRAW MESSAGE
1100 C=16
1110 A=12+2*32+&H1800
1120 FOR I=0 TO 7
1130  VPOKE A+I,C+I
1140  VPOKE A+I+32,C+I+32
1150 NEXT
1160 '
1170 RETURN
1180 '
1190 '= DRAW FUJIYAMA (P:0-3)
1200 C=64+(P AND 1)*16+(P\2)*32*3
1210 B=2+(P AND 1)*3+(P\2)*32
1220 A=8+8*32+&H1800
1230 FOR I=0 TO 15
1240  VPOKE A+I,C+I
1250  VPOKE A+I+32,C+I+32
1260  VPOKE A+I+64,C+I+64
1270  VPOKE A+I+96,B
1280  VPOKE A+I+128,B+1
1290  VPOKE A+I+160,B+2
1300 NEXT
1310 '
1320 RETURN
1330 '
1340 '= DRAW UMA
1350 X=X AND 31:C=UP*2:A=X+Y*32+&H1800
1360 VPOKE A,C:VPOKE A+32,C+32
1370 IF X>30 THEN RETURN
1380 VPOKE A+1,C+1:VPOKE A+33,C+33
1390 RETURN
1400 '
1410 '= ERASE UMA
1420 X=(X AND 31):A=X+Y*32+&H1800
1430 VPOKE A,32:VPOKE A+32,32
1440 IF X>30 THEN RETURN
1450 VPOKE A+1,32:VPOKE A+33,32
1460 RETURN
1470 '
1480 '= SPRITE UMA
1490 X=X:C=UP
1500 PUTSPRITE PI,(X,Y),CL,C
1510 RETURN
2000 '

100 CLEAR200,&HC000:DEFINTA-Z
110 SCREEN4,3
120 BLOAD"2026F.SC2",S
130 LINE(0,0)-(255,127),0,BF
140 FOR I=0 TO 63
150  E=I AND 31:X=I AND 7:Y=(I\8)AND3:PUTSPRITE E,(X*32,Y*32),15,I
160  S=(I AND 15)*16+(I\16)*512+&H1000
170  D=I*32+&H3800
180  FOR J=0 TO 7
190   VPOKE D+J,VPEEK(S+J)
200   VPOKE D+8+J,VPEEK(S+256+J)
210   VPOKE D+16+J,VPEEK(S+8+J)
220   VPOKE D+24+J,VPEEK(S+264+J)
230  NEXT J
240 NEXT I
250 BSAVE"2026.SPR",&H3800,&H3FFF,S

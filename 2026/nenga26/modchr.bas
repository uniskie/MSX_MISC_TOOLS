1000 '
1010 ' PAT CHK
1020 ' CH=(0 - 255)*3:BG=BGCOLOR
1030 PT=CH*8:CT=&H2000+PT
1040 PD=(CH AND 255)*8:CD=&H2000+PD
1050 FOR K=0 TO 7
1060  P=VPEEK(PT+K)
1070  C=VPEEK(CT+K):F=C\16:B=C AND 15
1080  IF(P=0)AND(B=BG)THEN 1130
1090  IF B=BG THEN 1130
1100  IF F=BG THEN 1120
1110  IF F>B THEN 1130

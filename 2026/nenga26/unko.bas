10 CLEAR 100:DEFINTA-Z
20 DIM X(31),Y(31)
30 COLOR15,0,0:SCREEN1,2:KEYOFF
40 ' SET SPR.PAT.GEN
50 FOR I=0 TO 3
60  S$="":READ D$
70  FOR J=0 TO 31
80   S$=S$+CHR$(VAL("&h"+MID$(D$,J*2+1,2)))
90  NEXT
100  SPRITE$(I)=S$
110 NEXT
120 ' SET DEF.PARAM
130 X=0:Y=160:VX=4:VY=-16:DY=VY
140 P=0
150 ' SET INITIAL POS ARRAY
160 FOR I=0 TO 31
170  Y(I)=Y:X(I)=X+I*4
180 NEXT
190 ' == LOOP
200 ' DISPLAY
210 J=P:TIME=0
220 FOR I=0 TO 3
230  PUTSPRITE I,(X(J),Y(J)),9+I,I
240  J=(J+4)AND 31
250 NEXT
260 ' MOVE
270 P=(P-1)AND 31
280 Y=Y+VY:VY=VY+1:IF Y>=160 THEN VY=-16:Y=160
290 X=X+VX:IF(X>=240)OR(X<=0)THEN VX=-VX
300 X(P)=X:Y(P)=Y
310 IF TIME<4 THEN 310
320 GOTO 210

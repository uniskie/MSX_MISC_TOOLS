10 FILES:PRINT:INPUT "bin file"; F$
20 OPEN F$ AS #1 LEN=7:FIELD #1,7 AS A$:GET #1,1:CLOSE
30 FORJ=0TO2:AD(J)=ASC(MID$(A$,2+J*2,1))+ASC(MID$(A$,3+J*2,1))*256:NEXT
40 PRINT F$:PRINT" START:$"+HEX$(AD(0))+" END:$"+HEX$(AD(1))+" RUN:$"+HEX$(AD(2))
50 H=PEEK(&HFC4A)+PEEK(&HFC4B)*256:PRINT"HIMEM:$";HEX$(H)
60 IF H < AD(1) THEN PRINT"END ADDRES OVER HIMEM":I$=INPUT$(1)
